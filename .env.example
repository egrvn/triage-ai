NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# memory works without external services and is the default for demos.
# Use postgres together with DATABASE_URL for Cloud.ru / Docker deployment.
STORAGE_MODE=memory
DATABASE_URL=postgresql://coursework:coursework@localhost:5432/coursework?schema=public

# Frontend dev server. In production the API serves the built frontend from apps/web/dist.
VITE_API_BASE_URL=http://localhost:4000

# Optional future adapters. Do not commit real secrets.
LLM_PROVIDER=mock
GIGACHAT_API_KEY=
YANDEXGPT_API_KEY=
OPENAI_API_KEY=
